# ===========================================================================
# Variables de entorno · Polla Ganadora
#
# Copia este archivo como ".env.local" para desarrollo local, y registra las
# MISMAS variables en Vercel (Project Settings → Environment Variables).
# ===========================================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto, p.ej. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta "service_role" — ¡SOLO en el servidor, nunca con NEXT_PUBLIC!
# Se usa para que el panel Admin guarde los resultados reales.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administrador ---
# PIN que pide /admin para poder cargar resultados. Pon el que quieras.
ADMIN_PIN=
