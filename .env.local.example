# ===========================================================================
# Variables de entorno · Polla Ganadora
#
# Copia este archivo como ".env.local" para desarrollo local, y registra las
# MISMAS variables en Vercel (Project Settings → Environment Variables).
# ===========================================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto, p.ej. https://abcdxyz.supabase.co  (REQUERIDA)
NEXT_PUBLIC_SUPABASE_URL=

# Clave secreta "service_role" — ¡SOLO servidor, nunca con NEXT_PUBLIC! (REQUERIDA)
# Todo el acceso a datos pasa por el servidor con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administrador ---
# PIN que pide /admin para cargar resultados. Pon el que quieras. (REQUERIDA)
ADMIN_PIN=

# --- Opcional: resultados en vivo / sincronización ---
# Los marcadores en vivo se traen de ESPN (gratis, sin key) automáticamente.
# CRON_SECRET solo se necesita si configuras un cron externo que llame a
# /api/sync (ver README). Si lo defines, el cron debe mandar el header
# "Authorization: Bearer <CRON_SECRET>" o ?secret=<CRON_SECRET>.
# CRON_SECRET=

# --- Opcional ---
# La clave pública "anon" YA NO se usa (el navegador no habla con Supabase
# directo). Puedes dejarla vacía o borrar esta línea.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
